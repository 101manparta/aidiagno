rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapSuperAdmin() {
      return isEmailVerified() && request.auth.token.email == 'manparta0101@gmail.com';
    }

    function isAdmin() {
      return isEmailVerified() && (
        isBootstrapSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isEmailVerified() && (
        isBootstrapSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
        )
      );
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Validation Blueprints
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isNonEmptyString(data.email, 254)
        && isNonEmptyString(data.displayName, 120)
        && (data.role == 'SUPER_ADMIN' || data.role == 'EDITOR')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['brandName', 'seoTitle', 'seoDescription', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['brandName', 'logoUrl', 'contactEmail', 'contactWhatsapp', 'officeAddress', 'seoTitle', 'seoDescription', 'footerNote', 'updatedAt', 'updatedBy'])
        && isNonEmptyString(data.brandName, 80)
        && (!('logoUrl' in data) || isOptionalString(data.logoUrl, 500))
        && (!('contactEmail' in data) || isOptionalString(data.contactEmail, 254))
        && (!('contactWhatsapp' in data) || isOptionalString(data.contactWhatsapp, 40))
        && (!('officeAddress' in data) || isOptionalString(data.officeAddress, 300))
        && isNonEmptyString(data.seoTitle, 120)
        && isNonEmptyString(data.seoDescription, 320)
        && (!('footerNote' in data) || isOptionalString(data.footerNote, 240))
        && data.updatedAt == request.time
        && isNonEmptyString(data.updatedBy, 254);
    }

    function isValidHomepageContent(data) {
      return data.keys().hasAll(['status', 'heroTitle', 'heroSubtitle', 'heroPrimaryCta', 'heroSecondaryCta', 'demoEnabled', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['status', 'heroTitle', 'heroSubtitle', 'heroPrimaryCta', 'heroSecondaryCta', 'heroImageUrl', 'challenges', 'solutionsIntro', 'differentiators', 'ctaTitle', 'ctaSubtitle', 'aboutMission', 'aboutVision', 'demoEnabled', 'demoDefaultTab', 'demoBannerNote', 'updatedAt', 'updatedBy'])
        && (data.status == 'draft' || data.status == 'published')
        && isNonEmptyString(data.heroTitle, 180)
        && isNonEmptyString(data.heroSubtitle, 500)
        && isNonEmptyString(data.heroPrimaryCta, 60)
        && isNonEmptyString(data.heroSecondaryCta, 60)
        && (!('heroImageUrl' in data) || isOptionalString(data.heroImageUrl, 500))
        && (!('challenges' in data) || (data.challenges is list && data.challenges.size() <= 8))
        && (!('solutionsIntro' in data) || isOptionalString(data.solutionsIntro, 400))
        && (!('differentiators' in data) || (data.differentiators is list && data.differentiators.size() <= 8))
        && (!('ctaTitle' in data) || isOptionalString(data.ctaTitle, 180))
        && (!('ctaSubtitle' in data) || isOptionalString(data.ctaSubtitle, 400))
        && (!('aboutMission' in data) || isOptionalString(data.aboutMission, 1000))
        && (!('aboutVision' in data) || isOptionalString(data.aboutVision, 1000))
        && data.demoEnabled is bool
        && (!('demoDefaultTab' in data) || isOptionalString(data.demoDefaultTab, 40))
        && (!('demoBannerNote' in data) || isOptionalString(data.demoBannerNote, 300))
        && data.updatedAt == request.time
        && isNonEmptyString(data.updatedBy, 254);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['slug', 'name', 'tagline', 'summary', 'iconKey', 'sortOrder', 'status', 'features', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['slug', 'name', 'tagline', 'summary', 'iconKey', 'imageUrl', 'sortOrder', 'status', 'features', 'updatedAt', 'updatedBy'])
        && isNonEmptyString(data.slug, 80)
        && isNonEmptyString(data.name, 120)
        && isNonEmptyString(data.tagline, 200)
        && isNonEmptyString(data.summary, 600)
        && isNonEmptyString(data.iconKey, 40)
        && (!('imageUrl' in data) || isOptionalString(data.imageUrl, 500))
        && data.sortOrder is number
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived')
        && data.features is list && data.features.size() <= 20
        && data.updatedAt == request.time
        && isNonEmptyString(data.updatedBy, 254);
    }

    function isValidPricingPlan(data) {
      return data.keys().hasAll(['slug', 'name', 'targetAudience', 'description', 'showPrice', 'isCustomQuote', 'currency', 'sortOrder', 'status', 'features', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['slug', 'name', 'targetAudience', 'description', 'showPrice', 'isCustomQuote', 'currency', 'monthlyPrice', 'annualPrice', 'implementationFee', 'billingNote', 'ctaLabel', 'highlighted', 'sortOrder', 'status', 'features', 'updatedAt', 'updatedBy'])
        && isNonEmptyString(data.slug, 80)
        && isNonEmptyString(data.name, 80)
        && isNonEmptyString(data.targetAudience, 160)
        && isNonEmptyString(data.description, 400)
        && data.showPrice is bool
        && data.isCustomQuote is bool
        && isNonEmptyString(data.currency, 10)
        && (!('monthlyPrice' in data) || data.monthlyPrice == null || data.monthlyPrice is number)
        && (!('annualPrice' in data) || data.annualPrice == null || data.annualPrice is number)
        && (!('implementationFee' in data) || data.implementationFee == null || data.implementationFee is number)
        && (!('billingNote' in data) || isOptionalString(data.billingNote, 200))
        && (!('ctaLabel' in data) || isOptionalString(data.ctaLabel, 60))
        && (!('highlighted' in data) || data.highlighted is bool)
        && data.sortOrder is number
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived')
        && data.features is list && data.features.size() <= 20
        && data.updatedAt == request.time
        && isNonEmptyString(data.updatedBy, 254);
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['slug', 'title', 'category', 'excerpt', 'content', 'authorName', 'readMinutes', 'status', 'publishedDate', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['slug', 'title', 'category', 'excerpt', 'content', 'coverImageUrl', 'authorName', 'readMinutes', 'status', 'publishedDate', 'createdAt', 'updatedAt', 'updatedBy'])
        && isNonEmptyString(data.slug, 120)
        && isNonEmptyString(data.title, 200)
        && isNonEmptyString(data.category, 60)
        && isNonEmptyString(data.excerpt, 400)
        && isNonEmptyString(data.content, 20000)
        && (!('coverImageUrl' in data) || isOptionalString(data.coverImageUrl, 500))
        && isNonEmptyString(data.authorName, 100)
        && data.readMinutes is number
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived')
        && isNonEmptyString(data.publishedDate, 30)
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && isNonEmptyString(data.updatedBy, 254);
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['title', 'altText', 'url', 'category', 'createdAt', 'updatedBy'])
        && data.keys().hasOnly(['title', 'altText', 'url', 'category', 'createdAt', 'updatedBy'])
        && isNonEmptyString(data.title, 120)
        && isNonEmptyString(data.altText, 240)
        && isNonEmptyString(data.url, 700000)
        && isNonEmptyString(data.category, 60)
        && data.createdAt == request.time
        && isNonEmptyString(data.updatedBy, 254);
    }

    function isValidConsultationLead(data) {
      return data.keys().hasAll(['fullName', 'facilityName', 'facilityType', 'requiredSolution', 'contactChannel', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'facilityName', 'facilityType', 'requiredSolution', 'contactChannel', 'message', 'status', 'adminNotes', 'createdAt', 'updatedAt'])
        && isBoundedString(data.fullName, 2, 120)
        && isBoundedString(data.facilityName, 2, 160)
        && isBoundedString(data.facilityType, 2, 80)
        && isBoundedString(data.requiredSolution, 2, 120)
        && isBoundedString(data.contactChannel, 5, 160)
        && (
          data.contactChannel.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') ||
          data.contactChannel.matches('^\\+?[0-9][0-9\\s\\-]{7,18}$')
        )
        && (!('message' in data) || isOptionalString(data.message, 2000))
        && (!('adminNotes' in data) || isOptionalString(data.adminNotes, 2000))
        && (
          data.status == 'Baru' ||
          data.status == 'Dihubungi' ||
          data.status == 'Konsultasi Terjadwal' ||
          data.status == 'Selesai' ||
          data.status == 'Ditolak' ||
          data.status == 'new' ||
          data.status == 'contacted' ||
          data.status == 'demo_scheduled' ||
          data.status == 'closed' ||
          data.status == 'archived'
        )
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidConsultation(data) {
      return data.keys().hasAll(['fullName', 'facilityName', 'facilityType', 'requiredSolution', 'contactChannel', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'facilityName', 'facilityType', 'requiredSolution', 'contactChannel', 'message', 'status', 'adminNotes', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.fullName, 120)
        && isNonEmptyString(data.facilityName, 160)
        && isNonEmptyString(data.facilityType, 80)
        && isNonEmptyString(data.requiredSolution, 120)
        && isNonEmptyString(data.contactChannel, 160)
        && (!('message' in data) || isOptionalString(data.message, 2000))
        && (!('adminNotes' in data) || isOptionalString(data.adminNotes, 2000))
        && (
          data.status == 'Baru' ||
          data.status == 'Dihubungi' ||
          data.status == 'Konsultasi Terjadwal' ||
          data.status == 'Selesai' ||
          data.status == 'Ditolak' ||
          data.status == 'new' ||
          data.status == 'contacted' ||
          data.status == 'demo_scheduled' ||
          data.status == 'closed' ||
          data.status == 'archived'
        )
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['entityType', 'entityId', 'action', 'summary', 'actorEmail', 'actorUid', 'createdAt'])
        && data.keys().hasOnly(['entityType', 'entityId', 'action', 'summary', 'actorEmail', 'actorUid', 'createdAt'])
        && isNonEmptyString(data.entityType, 60)
        && isNonEmptyString(data.entityId, 128)
        && (data.action == 'create' || data.action == 'update' || data.action == 'publish' || data.action == 'archive' || data.action == 'delete')
        && isNonEmptyString(data.summary, 300)
        && isNonEmptyString(data.actorEmail, 254)
        && data.actorUid == request.auth.uid
        && data.createdAt == request.time;
    }

    // Admin Users Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isBootstrapSuperAdmin() || (isEmailVerified() && request.auth.uid == adminId));
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(adminId) && isSuperAdmin() && isValidAdminUser(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(adminId) && isSuperAdmin() && isValidAdminUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    // Site Settings Collection
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming());
      allow update: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming());
      allow delete: if isValidId(settingId) && isSuperAdmin();
    }

    // Homepage Content Collection
    match /homepage_content/{docId} {
      allow get: if isValidId(docId) && (existing().status == 'published' || isAdmin());
      allow list: if isBootstrapSuperAdmin() || resource.data.status == 'published';
      allow create: if isValidId(docId) && isAdmin() && isValidHomepageContent(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidHomepageContent(incoming());
      allow delete: if isValidId(docId) && isSuperAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().status == 'published' || isAdmin());
      allow list: if isBootstrapSuperAdmin() || resource.data.status == 'published';
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Pricing Plans Collection
    match /pricing_plans/{planId} {
      allow get: if isValidId(planId) && (existing().status == 'published' || isAdmin());
      allow list: if isBootstrapSuperAdmin() || resource.data.status == 'published';
      allow create: if isValidId(planId) && isAdmin() && isValidPricingPlan(incoming());
      allow update: if isValidId(planId) && isAdmin() && isValidPricingPlan(incoming());
      allow delete: if isValidId(planId) && isAdmin();
    }

    // Articles Collection
    match /articles/{articleId} {
      allow get: if isValidId(articleId) && (existing().status == 'published' || isAdmin());
      allow list: if isBootstrapSuperAdmin() || resource.data.status == 'published';
      allow create: if isValidId(articleId) && isAdmin() && isValidArticle(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(articleId) && isAdmin() && isValidArticle(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(articleId) && isAdmin();
    }

    // Media Library Collection
    match /media_assets/{assetId} {
      allow get: if isValidId(assetId) && isAdmin();
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(assetId) && isAdmin() && isValidMediaAsset(incoming());
      allow update: if isValidId(assetId) && isAdmin() && isValidMediaAsset(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(assetId) && isAdmin();
    }

    // Primary Consultation Leads Collection (Public Write-Only Create, Admin Read/Manage)
    match /consultation_leads/{leadId} {
      allow get: if isValidId(leadId) && isAdmin();
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(leadId) && isValidConsultationLead(incoming()) && incoming().status == 'Baru' && !('adminNotes' in incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(leadId) && isAdmin() && isValidConsultationLead(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isValidId(leadId) && isSuperAdmin();
    }

    // Legacy Consultations Collection (Retained for Admin Read/Manage Compatibility)
    match /consultations/{leadId} {
      allow get: if isValidId(leadId) && isAdmin();
      allow list: if isBootstrapSuperAdmin();
      allow create: if false;
      allow update: if isValidId(leadId) && isAdmin() && isValidConsultation(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isValidId(leadId) && isSuperAdmin();
    }

    // Audit Logs Collection (Append-only by Admins)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming());
      allow update: if false;
      allow delete: if false;
    }

    // Connection test path (read-only ping)
    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}
